<!DOCTYPE html>
<html>
<head>
    <title>Edit Card</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="form-page">

    <form
        action="/edit/<%= card.id %>?_method=PUT"
        method="POST"
        class="modern-form"
    >

        <h1>Edit Card</h1>

        <input
            type="text"
            name="owner_name"
            value="<%= card.owner_name %>"
        >

        <input
            type="email"
            name="email"
            value="<%= card.email %>"
        >

        <input
            type="text"
            name="card_number"
            value="<%= card.card_number %>"
        >

        <input
            type="number"
            step="0.01"
            name="balance"
            value="<%= card.balance %>"
        >

        <input
            type="text"
            name="country"
            value="<%= card.country %>"
        >

        <button type="submit">
            Update Card
        </button>

    </form>

</div>

</body>
</html>